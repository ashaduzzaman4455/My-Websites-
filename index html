<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GlowMart — latest shopping vibe</title>
  <!-- Font Awesome 6 (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <style>
    /* ---------- RESET & BASE ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background: #f4f6fa;
      color: #1e1e2a;
      line-height: 1.4;
    }

    /* ---------- UTILITY ---------- */
    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .section-title {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title i {
      color: #2563eb;
      font-size: 1.6rem;
    }

    .badge-new {
      background: #2563eb;
      color: #fff;
      font-size: 0.65rem;
      font-weight: 600;
      padding: 2px 10px;
      border-radius: 30px;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }

    /* ---------- TOP BAR (mini) ---------- */
    .top-bar {
      background: #1e1e2a;
      color: #b0b3c0;
      font-size: 0.75rem;
      padding: 8px 0;
      border-bottom: 1px solid #2d2d3e;
    }
    .top-bar .container {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px 12px;
    }
    .top-bar a {
      color: #b0b3c0;
      text-decoration: none;
      transition: color 0.2s;
    }
    .top-bar a:hover {
      color: #fff;
    }
    .top-bar .right span {
      margin-left: 18px;
    }
    .top-bar .right i {
      margin-right: 6px;
    }

    /* ---------- HEADER / NAV ---------- */
    .main-header {
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(8px);
      background: rgba(255, 255, 255, 0.92);
      border-bottom: 1px solid rgba(0, 0, 0, 0.03);
    }
    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      padding: 14px 0;
      gap: 12px;
    }
    .logo {
      font-size: 1.9rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #0a0a14;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .logo i {
      color: #2563eb;
      font-size: 2rem;
    }
    .logo span {
      color: #2563eb;
    }

    .search-bar {
      flex: 1 1 340px;
      display: flex;
      background: #f1f4f9;
      border-radius: 60px;
      padding: 4px 4px 4px 20px;
      align-items: center;
      border: 1px solid #e6ebf2;
      transition: 0.2s;
    }
    .search-bar:focus-within {
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
      background: #ffffff;
    }
    .search-bar input {
      border: none;
      background: transparent;
      padding: 12px 0;
      font-size: 0.95rem;
      flex: 1;
      outline: none;
      color: #1e1e2a;
    }
    .search-bar input::placeholder {
      color: #8a8fa0;
    }
    .search-bar button {
      background: #2563eb;
      border: none;
      color: white;
      padding: 10px 22px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .search-bar button:hover {
      background: #1d4ed8;
      transform: scale(0.97);
    }

    .nav-icons {
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .nav-icons a {
      color: #1e1e2a;
      font-size: 1.3rem;
      text-decoration: none;
      position: relative;
      transition: 0.2s;
    }
    .nav-icons a:hover {
      color: #2563eb;
    }
    .nav-icons .cart-badge {
      background: #2563eb;
      color: #fff;
      font-size: 0.6rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 40px;
      position: absolute;
      top: -8px;
      right: -12px;
    }
    .nav-icons .user-icon {
      background: #eef2f6;
      border-radius: 40px;
      padding: 8px 14px;
      font-size: 0.9rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .nav-icons .user-icon i {
      font-size: 1.1rem;
    }

    /* ---------- CATEGORY STRIP ---------- */
    .category-strip {
      background: #ffffff;
      border-bottom: 1px solid #eef2f6;
      padding: 10px 0;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: thin;
    }
    .category-strip::-webkit-scrollbar {
      height: 4px;
      background: #eef2f6;
    }
    .category-strip::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 20px;
    }
    .cat-list {
      display: flex;
      gap: 28px;
      align-items: center;
    }
    .cat-list a {
      color: #2d3246;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      transition: 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .cat-list a i {
      font-size: 1rem;
      color: #5b677b;
    }
    .cat-list a:hover {
      color: #2563eb;
    }
    .cat-list a:hover i {
      color: #2563eb;
    }

    /* ---------- HERO / BANNER ---------- */
    .hero {
      margin: 28px 0 36px;
      background: linear-gradient(135deg, #eef3ff, #ffffff);
      border-radius: 32px;
      padding: 40px 44px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      border: 1px solid rgba(37, 99, 235, 0.08);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.02);
    }
    .hero-text {
      flex: 1 1 260px;
    }
    .hero-text .tag {
      background: #2563eb10;
      color: #2563eb;
      font-weight: 600;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
      padding: 4px 14px;
      border-radius: 40px;
      display: inline-block;
      margin-bottom: 12px;
      border: 1px solid #2563eb20;
    }
    .hero-text h1 {
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: 12px;
    }
    .hero-text h1 span {
      color: #2563eb;
      background: #2563eb0a;
      padding: 0 6px;
    }
    .hero-text p {
      color: #4a5066;
      max-width: 360px;
      margin-bottom: 24px;
      font-size: 1.05rem;
    }
    .hero-btn {
      background: #1e1e2a;
      color: white;
      border: none;
      padding: 14px 38px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.03);
    }
    .hero-btn:hover {
      background: #2563eb;
      transform: translateY(-3px);
      box-shadow: 0 16px 30px rgba(37, 99, 235, 0.2);
    }
    .hero-img {
      flex: 0 0 180px;
      text-align: center;
      font-size: 6rem;
      color: #2563eb20;
      background: #ffffffd0;
      padding: 16px 30px;
      border-radius: 60px;
      backdrop-filter: blur(4px);
      border: 1px solid #ffffff;
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.1);
    }

    /* ---------- PRODUCT GRID ---------- */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 28px;
      margin: 24px 0 48px;
    }

    .product-card {
      background: #ffffff;
      border-radius: 24px;
      padding: 20px 16px 18px;
      transition: 0.25s ease;
      border: 1px solid #f0f3f8;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.01);
      position: relative;
      display: flex;
      flex-direction: column;
    }
    .product-card:hover {
      transform: translateY(-8px);
      border-color: #dce3ef;
      box-shadow: 0 24px 50px -16px rgba(0, 0, 0, 0.08);
      background: #ffffff;
    }
    .product-card .image {
      background: #f8faff;
      border-radius: 18px;
      height: 170px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4.2rem;
      color: #1e1e2a30;
      margin-bottom: 14px;
      transition: 0.2s;
      border: 1px solid #f0f3fa;
    }
    .product-card:hover .image {
      background: #f0f5ff;
    }
    .product-card .product-tag {
      position: absolute;
      top: 16px;
      left: 16px;
      background: #2563eb;
      color: white;
      font-size: 0.6rem;
      font-weight: 700;
      padding: 3px 12px;
      border-radius: 40px;
      letter-spacing: 0.3px;
    }
    .product-card .product-tag.green {
      background: #0b8a5e;
    }
    .product-card h4 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 4px;
      color: #13131f;
    }
    .product-card .desc {
      font-size: 0.8rem;
      color: #6a728b;
      margin-bottom: 10px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .product-card .price-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: auto;
    }
    .product-card .price {
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.01em;
    }
    .product-card .price small {
      font-weight: 400;
      font-size: 0.7rem;
      color: #6e7a93;
      margin-left: 6px;
      text-decoration: line-through;
    }
    .product-card .add-btn {
      background: #f1f6fd;
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 60px;
      font-size: 1.2rem;
      color: #1e1e2a;
      cursor: pointer;
      transition: 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .product-card .add-btn:hover {
      background: #2563eb;
      color: white;
      transform: rotate(2deg) scale(1.03);
    }
    .rating {
      color: #f5b342;
      font-size: 0.75rem;
      letter-spacing: 2px;
      margin: 6px 0 8px;
    }
    .rating span {
      color: #7a829b;
      font-weight: 400;
      margin-left: 4px;
    }

    /* ---------- FEATURE BANNER (flash) ---------- */
    .flash-sale {
      background: #1e1e2a;
      border-radius: 28px;
      padding: 30px 36px;
      margin: 20px 0 40px;
      color: white;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(145deg, #1a1a2a, #25253b);
    }
    .flash-sale .left h3 {
      font-size: 1.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .flash-sale .left h3 i {
      color: #facc15;
    }
    .flash-sale .countdown {
      display: flex;
      gap: 14px;
      font-weight: 600;
    }
    .flash-sale .countdown div {
      background: #ffffff10;
      backdrop-filter: blur(4px);
      padding: 10px 16px;
      border-radius: 60px;
      border: 1px solid #ffffff18;
      font-size: 1rem;
    }
    .flash-sale .countdown span {
      font-weight: 300;
      opacity: 0.7;
      margin: 0 4px;
    }
    .flash-btn {
      background: #facc15;
      color: #1a1a2a;
      padding: 12px 32px;
      border-radius: 60px;
      font-weight: 700;
      border: none;
      cursor: pointer;
      transition: 0.2s;
    }
    .flash-btn:hover {
      background: white;
      transform: scale(0.96);
    }

    /* ---------- FOOTER ---------- */
    .footer {
      background: #0d0d17;
      color: #b2b8cc;
      padding: 48px 0 20px;
      margin-top: 60px;
      border-radius: 40px 40px 0 0;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 36px;
      margin-bottom: 32px;
    }
    .footer-grid h5 {
      color: #fff;
      font-weight: 600;
      margin-bottom: 14px;
      font-size: 1rem;
    }
    .footer-grid a {
      display: block;
      color: #b2b8cc;
      text-decoration: none;
      font-size: 0.9rem;
      margin: 6px 0;
      transition: 0.2s;
    }
    .footer-grid a:hover {
      color: #fff;
      padding-left: 4px;
    }
    .footer-bottom {
      border-top: 1px solid #242435;
      padding-top: 24px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      font-size: 0.8rem;
    }
    .social i {
      font-size: 1.2rem;
      margin-left: 16px;
      transition: 0.2s;
      cursor: pointer;
    }
    .social i:hover {
      color: #fff;
      transform: scale(1.1);
    }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 700px) {
      .hero {
        flex-direction: column;
        text-align: center;
        padding: 28px 20px;
      }
      .hero-text p {
        max-width: 100%;
      }
      .hero-img {
        margin-top: 24px;
        font-size: 4.5rem;
        padding: 12px 24px;
      }
      .nav-container {
        flex-direction: column;
        align-items: stretch;
      }
      .search-bar {
        flex: 1 1 auto;
      }
      .nav-icons {
        justify-content: flex-end;
      }
      .section-title {
        font-size: 1.5rem;
      }
      .flash-sale {
        flex-direction: column;
        gap: 20px;
        text-align: center;
      }
    }
    @media (max-width: 480px) {
      .product-grid {
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
    }
  </style>
</head>
